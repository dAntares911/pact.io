{
  "consumer": {
    "name": "order-service"
  },
  "provider": {
    "name": "user-service"
  },
  "interactions": [
    {
      "description": "a request for user 1",
      "providerState": "user 1 exists",
      "request": {
        "method": "GET",
        "path": "/users/1"
      },
      "response": {
        "status": 200,
        "headers": {
        },
        "body": {
          "id": 1,
          "name": "John Doe",
          "email": "john@example.com"
        },
        "matchingRules": {
          "$.body.name": {
            "match": "type"
          },
          "$.body.email": {
            "match": "regex",
            "regex": ".+@.+\\..+"
          }
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "2.0.0"
    }
  }
}